PORT=5000

# Option 1: Hosted Postgres (e.g. Neon) - just paste the connection string here
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Option 2: Local Postgres - fill these instead, and remove/comment out DATABASE_URL above
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_HOST=localhost
DB_PORT=5432
DB_NAME=store_rating_db

JWT_SECRET=change_this_secret_key
